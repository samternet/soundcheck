{
  "name": "soundcheck",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "lint": "oxlint src server/src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/src/**/*.ts\" \"*.{json,ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/src/**/*.ts\" \"*.{json,ts,js}\"",
    "typecheck": "tsc -b --noEmit && npm --prefix server run typecheck",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
