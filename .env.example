# Soundcheck configuration
#
# Copy this file to `.env` and fill it in before the first start:
#
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically. Your `.env` is never committed.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Timezone for daily and monthly statistics, so each day starts at your own
# midnight. Use an IANA timezone name, not an abbreviation like "IST" (several
# countries share those). Full list:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
#
# Examples: Asia/Kolkata (India), Europe/London, America/New_York, UTC
TZ=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Port Soundcheck is served on, i.e. http://localhost:7096
SOUNDCHECK_PORT=7096

# Pre-fills the server address on the very first admin setup screen. Has no
# effect once a server is connected. Example: http://192.168.1.10:8096
JELLYFIN_URL=

# Jellyfin's public address, used only for "Open in Jellyfin" links when
# Soundcheck is opened from outside your local network. Can also be set later in
# Admin Settings. Example: https://jellyfin.example.com
JELLYFIN_PUBLIC_URL=

# Same idea, for when Soundcheck is opened over Tailscale (100.x.x.x or
# *.ts.net). Falls back to JELLYFIN_PUBLIC_URL if left empty.
# Example: http://100.x.x.x:8096
JELLYFIN_TAILSCALE_URL=
